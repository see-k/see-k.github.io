---
import BaseLayout from '../layouts/BaseLayout.astro';

const postModules = import.meta.glob('./posts/*.md', { eager: true });
const posts = Object.entries(postModules).map(([path, mod]: [string, any]) => ({
  url: path.replace('./posts/', '/posts/').replace('.md', ''),
  frontmatter: mod.frontmatter,
}));
---

<BaseLayout title="Writing — Chike Okonta" activeNav="writing">
  <header class="topbar container">
    <div>
      <div class="eyebrow">Writing</div>
      <strong class="topbar-title">Posts, notes, and build logs</strong>
    </div>
  </header>
  <main class="section container page-gap">
    <div class="section-heading">
      <span class="section-tag">Essays</span>
      <h1 class="page-title">Writing</h1>
      <p>
        A lightweight technical writing section for engineering essays, architecture notes, and
        build logs.
      </p>
    </div>
    <div class="post-list panel">
      {
        posts.map((post) => (
          <a class="post-row" href={post.url}>
            <div>
              <span class="post-date">{post.frontmatter.date}</span>
              <h3>{post.frontmatter.title}</h3>
            </div>
            <p>{post.frontmatter.description}</p>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
