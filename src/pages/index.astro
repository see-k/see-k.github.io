---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Chike Okonta — Engineering Portfolio"
  description="Engineering portfolio and technical work by Chike Okonta."
  activeNav="home"
>
  <header class="topbar container">
    <div>
      <div class="eyebrow">see-k.github.io</div>
      <strong class="topbar-title">Technical portfolio</strong>
    </div>
  </header>

  <main>
    <section class="hero container">
      <div class="eyebrow">Developer portfolio / technical writing / build notes</div>
      <h1>Chike Okonta</h1>
      <p class="hero-copy">
        I build software, agent systems, and practical automation. This is the technical side of my
        work — deeper project context, architecture notes, experiments, and writing for people who
        care how things are built.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/projects">View projects</a>
        <a class="button secondary" href="/writing">Read posts</a>
      </div>
      <div class="meta-grid">
        <div class="meta-card">
          <span class="meta-label">Focus</span>
          <strong>AI systems, dev tooling, automation</strong>
        </div>
        <div class="meta-card">
          <span class="meta-label">Style</span>
          <strong>Product-minded engineering with sharp execution</strong>
        </div>
        <div class="meta-card">
          <span class="meta-label">Elsewhere</span>
          <strong>
            <a href="https://github.com/see-k" target="_blank" rel="noreferrer">GitHub</a> ·
            <a href="https://chikeokonta.com" target="_blank" rel="noreferrer">Website</a>
          </strong>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
