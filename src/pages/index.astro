---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Chike Okonta — Engineering Portfolio"
  description="Engineering portfolio and technical work by Chike Okonta."
  activeNav="home"
>
  <header class="topbar container">
    <div>
      <div class="eyebrow">see-k.github.io</div>
      <strong class="topbar-title">Technical portfolio</strong>
    </div>
  </header>

  <main>
    <section class="hero container">
      <div class="eyebrow">Developer portfolio / technical writing / build notes</div>
      <h1>Chike Okonta</h1>
      <p class="hero-copy">
        I build software, agent systems, and practical automation. This is the technical side of my
        work — deeper project context, architecture notes, experiments, and writing for people who
        care how things are built.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/projects">View projects</a>
        <a class="button secondary" href="/writing">Read posts</a>
      </div>
      <div class="meta-grid">
        <div class="meta-card">
          <span class="meta-label">Focus</span>
          <strong>AI systems, dev tooling, automation</strong>
        </div>
        <div class="meta-card">
          <span class="meta-label">Style</span>
          <strong>Product-minded engineering with sharp execution</strong>
        </div>
        <div class="meta-card">
          <span class="meta-label">Elsewhere</span>
          <strong>
            <a href="https://github.com/see-k" target="_blank" rel="noreferrer">GitHub</a> ·
            <a href="https://chikeokonta.com" target="_blank" rel="noreferrer">Website</a>
          </strong>
        </div>
      </div>
    </section>

    <section class="container">
      <div class="home-feature panel">
        <div class="home-feature-label">Published research · March 2026</div>
        <h2 class="home-feature-title">DAN: Dynamic Agent Network</h2>
        <p class="home-feature-desc">
          A distributed architecture for orchestrating adaptive multi-agent AI systems at scale —
          separating global coordination from local learning via case-based Q-learning, bandit-based
          routing, and a protocol bridging layer for A2A ↔ MCP interoperability.
        </p>
        <div class="publication-strip">
          <span class="publication-pill">Research paper</span>
          <span class="publication-pill">Zenodo</span>
          <span class="publication-pill">DOI: 10.5281/zenodo.19041902</span>
        </div>
        <div class="home-feature-links">
          <a href="/posts/dan-dynamic-agent-network">Read overview →</a>
          <a href="https://zenodo.org/records/19041902" target="_blank" rel="noreferrer">Published paper ↗</a>
        </div>
      </div>

      <div class="home-feature panel">
        <div class="home-feature-label">Framework essay · March 2026</div>
        <h2 class="home-feature-title">DEAS: Domain Experts As A Service</h2>
        <p class="home-feature-desc">
          A long-form framework essay on why many valuable AI products will not look like broad AGI apps,
          but like bounded expert services optimized for trust, workflow fit, and cost discipline.
        </p>
        <div class="publication-strip">
          <span class="publication-pill">Long-form essay</span>
          <span class="publication-pill">Systems framing</span>
          <span class="publication-pill">AGI vs DEAS</span>
        </div>
        <div class="home-feature-links">
          <a href="/posts/deas-domain-experts-as-a-service">Read essay →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
