---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Chike Okonta" activeNav="about">
  <header class="topbar container">
    <div>
      <div class="eyebrow">About</div>
      <strong class="topbar-title">Why this site exists</strong>
    </div>
  </header>
  <main class="section container page-gap">
    <div class="section-heading">
      <span class="section-tag">Context</span>
      <h1 class="page-title">About</h1>
    </div>
    <div class="panel about-panel about-panel--split">
      <img src="/assets/chikeProfilePic.png" alt="Chike Okonta" class="profile-pic" />
      <div class="about-body">
        <p>
          <strong>chikeokonta.com</strong> is my broader personal site. <strong
            >see-k.github.io</strong
          > is the more technical companion: deeper project context, engineering notes, blog posts, and
          details that matter more to technical readers than to a general audience.
        </p>
        <p>
          Over time, this should become a better map of how I think, what I build, and the systems I'm
          interested in shipping.
        </p>
        <div class="published-work panel">
          <div class="home-feature-label">Published work</div>
          <h3>DAN: A Dynamic, Distributed Agent Network for Scalable and Adaptive Orchestration</h3>
          <p>
            Open-access research on distributed multi-agent orchestration, protocol interoperability,
            and small-model coordination at the edge.
          </p>
          <div class="publication-strip">
            <span class="publication-pill">Zenodo</span>
            <span class="publication-pill">DOI: 10.5281/zenodo.19041902</span>
          </div>
          <div class="project-links">
            <a href="/posts/dan-dynamic-agent-network">Read overview →</a>
            <a href="https://zenodo.org/records/19041902" target="_blank" rel="noreferrer">Published paper ↗</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
