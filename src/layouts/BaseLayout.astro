---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'projects' | 'writing' | 'about';
}

const {
  title,
  description = 'Engineering portfolio and technical work by Chike Okonta.',
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="noise"></div>
    <button class="mobile-menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-expanded="false"
      >☰</button
    >

    <aside class="pill-nav" id="sidebar">
      <a class={`pill-item${activeNav === 'home' ? ' active' : ''}`} href="/" aria-label="Home">
        <span class="icon">⌂</span><span class="pill-label">Home</span>
      </a>
      <a
        class={`pill-item${activeNav === 'projects' ? ' active' : ''}`}
        href="/projects"
        aria-label="Projects"
      >
        <span class="icon">◫</span><span class="pill-label">Projects</span>
      </a>
      <a
        class={`pill-item${activeNav === 'writing' ? ' active' : ''}`}
        href="/writing"
        aria-label="Writing"
      >
        <span class="icon">✎</span><span class="pill-label">Writing</span>
      </a>
      <a
        class={`pill-item${activeNav === 'about' ? ' active' : ''}`}
        href="/about"
        aria-label="About"
      >
        <span class="icon">◎</span><span class="pill-label">About</span>
      </a>
      <a
        class="pill-item"
        href="https://github.com/see-k"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <span class="icon">↗</span><span class="pill-label">GitHub</span>
      </a>
      <a
        class="pill-item"
        href="https://chikeokonta.com"
        target="_blank"
        rel="noreferrer"
        aria-label="Main site"
      >
        <span class="icon">◇</span><span class="pill-label">Main site</span>
      </a>
    </aside>

    <div class="content-shell">
      <slot />

      <footer class="site-footer container">
        <p>© {new Date().getFullYear()} Chike Okonta</p>
        <div class="footer-icons">
          <a href="https://github.com/see-k" target="_blank" rel="noreferrer" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.52 11.52 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <a href="https://chikeokonta.com" target="_blank" rel="noreferrer" aria-label="Website">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </a>
        </div>
      </footer>
    </div>

    <script>
      const menuToggle = document.getElementById('menuToggle');
      menuToggle?.addEventListener('click', () => {
        document.body.classList.toggle('mobile-sidebar-open');
        menuToggle.setAttribute(
          'aria-expanded',
          String(document.body.classList.contains('mobile-sidebar-open')),
        );
      });
      document.querySelectorAll('#sidebar a').forEach((link) => {
        link.addEventListener('click', () => document.body.classList.remove('mobile-sidebar-open'));
      });
    </script>
  </body>
</html>
