---
import BaseLayout from './BaseLayout.astro';

interface RailItem {
  title: string;
  body?: string;
  bullets?: string[];
}

interface TocItem {
  label: string;
  href: string;
}

interface Props {
  frontmatter: {
    title: string;
    date: string;
    type: string;
    description: string;
    doi?: string;
    externalUrl?: string;
    publisher?: string;
    rightRailTitle?: string;
    rightRail?: RailItem[];
    tocTitle?: string;
    toc?: TocItem[];
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} — Chike Okonta`} activeNav="writing">
  <header class="topbar container">
    <div>
      <div class="eyebrow">Writing</div>
      <strong class="topbar-title">{frontmatter.type}</strong>
    </div>
  </header>
  <main class="article container">
    <div class={`article-layout${frontmatter.toc?.length ? ' article-layout--with-toc' : ''}${frontmatter.rightRail?.length ? ' article-layout--with-rail' : ''}`}>
      {frontmatter.toc?.length && (
        <aside class="article-toc">
          <div class="article-toc__inner">
            <div class="article-toc__header">{frontmatter.tocTitle ?? 'On this page'}</div>
            <nav class="article-toc__nav" aria-label="Table of contents">
              {frontmatter.toc.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </nav>
          </div>
        </aside>
      )}

      <article class="article-shell panel article-panel">
        <div class="code-chip">{frontmatter.type}</div>
        <h1>{frontmatter.title}</h1>
        <div class="post-meta-bar">
          <span>{frontmatter.date}</span>
          {frontmatter.publisher && <span>{frontmatter.publisher}</span>}
          {frontmatter.doi && <span>DOI: {frontmatter.doi}</span>}
        </div>
        {frontmatter.externalUrl && (
          <div class="publication-links">
            <a href={frontmatter.externalUrl} target="_blank" rel="noreferrer">Read published version ↗</a>
          </div>
        )}
        <slot />
        <p><a href="/writing">← Back to writing</a></p>
      </article>

      {frontmatter.rightRail?.length && (
        <aside class="article-rail">
          <div class="article-rail__inner">
            <div class="article-rail__header">{frontmatter.rightRailTitle ?? 'At a glance'}</div>
            {frontmatter.rightRail.map((item) => (
              <section class="article-rail__card panel">
                <h3>{item.title}</h3>
                {item.body && <p>{item.body}</p>}
                {item.bullets?.length && (
                  <ul>
                    {item.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
              </section>
            ))}
          </div>
        </aside>
      )}
    </div>
  </main>
</BaseLayout>
